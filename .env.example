# ─── Required API Keys ──────────────────────────────────────────────────────
# These must be set to run the pipeline.
OPENROUTER_API_KEY=sk-or-v1-
ELEVENLABS_API_KEY=
FISHAUDIO_API_KEY=
PEXELS_API_KEY=
SCRAPECREATORS_API_KEY=
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# ─── Text-to-Speech ─────────────────────────────────────────────────────────
# Provider order (first keyed provider wins): ElevenLabs → Gemini TTS → Fish Audio.
#
# ElevenLabs (primary, char-alignment timestamps). voice ID from elevenlabs.io.
# Free tier: premade voices only via API (e.g. George = JBFqnCBsd6RMkjVDRZzb);
# shared library voices need a paid plan. Defaults shown — uncomment to override.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2   # paid unlocks eleven_v3 / eleven_turbo_v2_5
# ELEVENLABS_VOICE_STABILITY=0.4             # 0.0–1.0
# ELEVENLABS_VOICE_SIMILARITY=0.75           # 0.0–1.0
# ELEVENLABS_VOICE_STYLE=0.7                 # 0.0–1.0, higher = more intonation
# ELEVENLABS_VOICE_SPEAKER_BOOST=true
# ELEVENLABS_VOICE_SPEED=1.0                 # 0.7–1.2, pacing
#
# Fish Audio (fallback): model ID from fish.audio/model
# FISH_AUDIO_VOICE_ID=90e65eaaf50e4470b8e6d43ee6afd7d5
# Gemini TTS (fallback): Google AI Studio prebuilt voice name
GEMINI_TTS_VOICE_NAME=Kore

# ─── Dashboard (required for web UI) ───────────────────────────────────────
# If DASHBOARD_USERNAME or DASHBOARD_PASSWORD is unset, all auth attempts are
# rejected (fails closed). If DASHBOARD_SECRET_KEY is unset, all state-changing
# requests (POST, PUT, PATCH, DELETE) return 403.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
DASHBOARD_SECRET_KEY=
# ⚠  IMPORTANT: If a value starts with '#', wrap it in double quotes:
#     DASHBOARD_PASSWORD="#my-secret"
#     DASHBOARD_SECRET_KEY="#abc123"
#   Unquoted values starting with '#' may be treated as comments by some
#   parsers (shell source, docker-compose, etc.). python-dotenv handles it
#   correctly, but quoting is the safe cross-tool convention.

# ─── Per-Agent LLM Models (optional — defaults from hierarchy preset) ─────────
# Uncomment to override the budget_east preset (clipper_agency/config/hierarchy.py).
# Must be canonical OpenRouter slugs: vendor/model (bare slugs 404). Startup
# preflight (config/preflight.py) validates these against the live catalog.
# SAFETY_MODEL=z-ai/glm-4.7-flash
# RESEARCHER_MODEL=xiaomi/mimo-v2.5
# SCRIPTWRITER_MODEL=qwen/qwen3-32b
# VISUAL_DIRECTOR_MODEL=xiaomi/mimo-v2.5
# REVIEWER_MODEL=google/gemini-2.5-flash

# ─── Logging ─────────────────────────────────────────────────────────────────
# DEBUG for verbose API traces, INFO for normal output, WARNING/ERROR for prod
LOG_LEVEL=INFO

# ─── Paths (optional — defaults shown) ───────────────────────────────────────
# These map to AppSettings fields and can be overridden via environment or .env.
DB_PATH=data/clipper.db
ASSETS_CACHE=assets/cache
OUTPUT_DIR=outputs

# ─── DEV gate-relax (optional — DEV ONLY) ───────────────────────────────────
# Comma-separated gate IDs to downgrade hard_fail → warn+continue. Merged with
# the CLI --relax-gates flag. Empty in production. NOT for production use.
# CLIPPER_RELAX_GATES=G4,G5
